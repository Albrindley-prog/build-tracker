# ask-assistant secrets — copy to `.env` for local `supabase functions serve`, and set the
# real values in the Supabase dashboard (Edge Functions -> Secrets) for the live function.
# `.env` files are git-ignored. Never paste a real key into a file that gets committed.

# You need ONE of these two keys. If neither is set, the function answers 503 NOT_CONFIGURED
# and tells visitors to email instead.
#
# Claude: create a key at https://console.anthropic.com (API keys). Starts with sk-ant-
ANTHROPIC_API_KEY=
#
# Google Gemini: create a key at https://aistudio.google.com ("Get API key"). Starts with AIza or AQ.
# Use a PAID-tier key for the live site: on Google's free tier, what visitors type can be used
# to improve Google's products.
GEMINI_API_KEY=

# Optional: "claude" or "gemini". If not set, Claude is used when there is an Anthropic key,
# otherwise Gemini.
# ASSISTANT_PROVIDER=gemini

# Optional. Defaults: claude-haiku-5-5 for Claude and gemini-3.5-flash-lite for Gemini (both
# the cheapest, quick ones). Use a bigger model for fuller answers (costs more per question),
# e.g. claude-sonnet-5-5 or gemini-3.6-flash.
# ASSISTANT_MODEL=

# Optional. By default the assistant answers questions about the business and steers other
# topics back. Set to "open" to let it chat about anything (company facts still only come
# from the fact sheet).
# ASSISTANT_SCOPE=open

# Optional. Set to false to switch the assistant off straight away.
# ASSISTANT_ENABLED=true

# Optional brakes (defaults shown).
# ASSISTANT_DAILY_LIMIT=300
# ASSISTANT_HOURLY_LIMIT=15

# Optional. Extra website addresses allowed to use the assistant, comma separated.
# build-tracker.co.uk, www.build-tracker.co.uk and localhost are always allowed.
# ASSISTANT_ALLOWED_ORIGINS=https://preview.example.com
